# Server Environment
NODE_ENV="development"
PORT=3000
DPC_DATA_DIR=""

# Server-Side Google Gemini Token (automatically injected / configured in Settings > Secrets)
GEMINI_API_KEY=""

# Optional Server-Side OpenRouter Key (Settings > Secrets fallback; users can also connect via OpenRouter OAuth PKCE)
OPENROUTER_API_KEY=""

# Optional Server-Side OpenAI Token (Settings > Secrets)
OPENAI_API_KEY=""

