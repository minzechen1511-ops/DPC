rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Entity Validation Blueprints (synchronized with firebase-blueprint.json)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'activeProjectId',
          'preferredLang',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'activeProjectId',
          'preferredLang',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.photoURL is string
        && data.photoURL.size() <= 1024
        && data.activeProjectId is string
        && data.activeProjectId.size() <= 128
        && data.preferredLang is string
        && data.preferredLang.size() <= 8
        && (data.preferredLang == 'en' || data.preferredLang == 'zh')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudioProject(data, userId, projectId) {
      return data.keys().hasAll([
          'projectId',
          'ownerId',
          'name',
          'schemaVersion',
          'revision',
          'createdAt',
          'updatedAt',
          'preferences',
          'workflow',
          'marketResearch',
          'intake',
          'uvz',
          'transformationMap',
          'referenceLibrary',
          'charter',
          'outline',
          'productBible',
          'resources',
          'qualityReport',
          'brand',
          'pricingReport',
          'salesAssets',
          'aiSettings'
        ])
        && data.keys().hasOnly([
          'projectId',
          'ownerId',
          'name',
          'schemaVersion',
          'isBlankProject',
          'revision',
          'createdAt',
          'updatedAt',
          'preferences',
          'workflow',
          'marketResearch',
          'intake',
          'uvz',
          'transformationMap',
          'referenceLibrary',
          'charter',
          'outline',
          'productBible',
          'resources',
          'qualityReport',
          'brand',
          'pricingReport',
          'salesAssets',
          'aiSettings'
        ])
        && isValidId(data.projectId)
        && data.projectId == projectId
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.name is string
        && data.name.size() <= 300
        && data.schemaVersion is string
        && data.schemaVersion.size() <= 16
        && (!('isBlankProject' in data) || data.isBlankProject is bool)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.preferences is map
        && data.workflow is map
        && data.marketResearch is map
        && data.intake is map
        && data.uvz is map
        && data.transformationMap is map
        && data.referenceLibrary is map
        && data.charter is map
        && data.outline is list
        && data.outline.size() <= 100
        && (data.outline.size() == 0 || data.outline[0] is map)
        && data.productBible is map
        && data.resources is list
        && data.resources.size() <= 100
        && (data.resources.size() == 0 || data.resources[0] is map)
        && data.qualityReport is map
        && data.brand is map
        && data.pricingReport is map
        && data.salesAssets is map
        && data.aiSettings is map
        && (!('apiKey' in data.aiSettings) || (data.aiSettings.apiKey is string && data.aiSettings.apiKey.size() == 0))
        && (!('baseUrl' in data.aiSettings) || (data.aiSettings.baseUrl is string && data.aiSettings.baseUrl.size() == 0));
    }

    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // 4. User Profile Collection (Strict PII Isolation)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'activeProjectId',
          'preferredLang',
          'updatedAt'
        ]);

      allow delete: if false;

      // 5. User Studio Projects Subcollection (Master Gate Relational Sync)
      match /projects/{projectId} {
        allow get: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && (resource == null || existing().ownerId == request.auth.uid)
          && hasValidParentUser(userId);

        allow list: if isValidId(userId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;

        allow create: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && isValidStudioProject(incoming(), userId, projectId)
          && incoming().revision == 1
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && hasValidParentUser(userId);

        allow update: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && isValidStudioProject(incoming(), userId, projectId)
          && existing().ownerId == request.auth.uid
          && existing().revision is int
          && incoming().ownerId == existing().ownerId
          && incoming().projectId == existing().projectId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().revision == existing().revision + 1
          && hasValidParentUser(userId)
          && (
            (
              // Action: Full project workspace sync / stage update
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name',
                'schemaVersion',
                'isBlankProject',
                'revision',
                'updatedAt',
                'preferences',
                'workflow',
                'marketResearch',
                'intake',
                'uvz',
                'transformationMap',
                'referenceLibrary',
                'charter',
                'outline',
                'productBible',
                'resources',
                'qualityReport',
                'brand',
                'pricingReport',
                'salesAssets',
                'aiSettings'
              ])
            )
          );

        allow delete: if isValidId(userId)
          && isValidId(projectId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && hasValidParentUser(userId);
      }
    }
  }
}
